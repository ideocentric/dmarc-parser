# Test, docs and sample-data tools. NOT installed in the production image;
# the Dockerfile's `test` stage (used by CI) adds them on top of production.
#
# Constrained by the production lockfile, so any package the two share stays
# on the same version. Regenerate AFTER requirements.txt, under Python 3.14:
#
#   pip-compile --generate-hashes --allow-unsafe --strip-extras \
#       --output-file=requirements-dev.txt requirements-dev.in
#
# Local development:  pip install -r requirements.txt -r requirements-dev.txt

-c requirements.txt

